# Copy this file to .env and fill in your values.
# .env is gitignored and never committed.

# Jira CLI config
JIRA_LOGIN=you@company.com
JIRA_SERVER=https://your-org.atlassian.net
JIRA_PROJECT_KEY=YOURKEY
JIRA_BOARD_ID=number_of_the_jira_board
# Generate at: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=your_jira_api_token_here

# Databricks config (find these in your Databricks workspace settings)
DATABRICKS_DEV_HOST=https://your-dev-workspace.cloud.databricks.com
DATABRICKS_PROD_HOST=https://your-prod-workspace.cloud.databricks.com
DATABRICKS_ACCOUNT_ID=your-databricks-account-uuid
DATABRICKS_DEV_WORKSPACE_ID=your-dev-workspace-id
DATABRICKS_PROD_WORKSPACE_ID=your-prod-workspace-id
#To Test NDOR
AWS_NDOR_AIRFLOW_ACCESS_KEY_ID=xxxxx
AWS_NDOR_AIRFLOW_SECRET_ACCESS_KEY=xxxxx
AWS_NDOR_DATABRICKS_ACCESS_KEY_ID=xxxxx
AWS_NDOR_DATABRICKS_SECRET_ACCESS_KEY=xxxx
