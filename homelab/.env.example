# Copy this file to .env and fill in the values. .env is gitignored.

# Host and connection
NUC_HOST=192.168.68.102
NUC_USER=me
# Private key that pyinfra uses. Leave empty to use the SSH agent.
NUC_SSH_KEY=~/.ssh/briareus-deploy
# Public key that is installed for the admin and agent users.
NUC_PUBKEY=~/.ssh/briareus.pub

# Tailnet name, read from `tailscale status` after phase 5.
TAILNET_NAME=

# OpenCode server password. One name only: the binary reads OPENCODE_PASSWORD.
OPENCODE_PASSWORD=

# Claude Code token, from `claude setup-token`.
CLAUDE_CODE_OAUTH_TOKEN=

# Tailscale auth key, tagged tag:server.
TS_AUTHKEY=

# Healthchecks.io check that the heartbeat pings.
HEALTHCHECKS_PING_URL=

# Backups: Backblaze B2 through the restic S3 backend.
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
