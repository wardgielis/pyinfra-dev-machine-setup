# Copy this file to .env and fill in the values. .env is gitignored.

# Host and connection
NUC_HOST=192.168.68.102
NUC_USER=me
# Private key that pyinfra uses. Leave empty to use the SSH agent.
NUC_SSH_KEY=~/.ssh/briareus-deploy
# Public key that is installed for the admin and agent users.
NUC_PUBKEY=~/.ssh/briareus.pub

# Tailnet name, read from `tailscale status` after phase 5.
TAILNET_NAME=

# OpenCode server password. One name only: the binary reads OPENCODE_PASSWORD.
OPENCODE_PASSWORD=

# Claude Code token, from `claude setup-token`.
CLAUDE_CODE_OAUTH_TOKEN=

# Tailscale auth key, tagged tag:server.
TS_AUTHKEY=

# Healthchecks.io check that the heartbeat pings.
HEALTHCHECKS_PING_URL=

# Backups: Backblaze B2 through the restic S3 backend.
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Work tokens for the OpenCode MCP servers and tools. Same identities as the laptop.
GRAFANA_URL=
GRAFANA_SERVICE_ACCOUNT_TOKEN=
GITLAB_TOKEN=
JIRA_API_TOKEN=
JIRA_LOGIN=
JIRA_SERVER=
JIRA_PROJECT_KEY=
JIRA_BOARD_ID=
ARGOCD_BASE_URL=
ARGOCD_API_TOKEN=
CLICKHOUSE_DEV_USER=
CLICKHOUSE_DEV_PASSWORD=
CLICKHOUSE_PROD_USER=
CLICKHOUSE_PROD_PASSWORD=

# Naturalis access. The key file is the personal Naturalis SSH key, exported from
# the password manager to a file outside the repo with mode 0600. Only the
# chtunnel user on the server holds it.
NATURALIS_SSH_KEY=~/.ssh/naturalis_work_pc
# VPN profile from https://naturalis.eduvpn.nl/, downloaded for the server. Either an
# OpenVPN file (.ovpn) or a WireGuard file (.conf). Mode 0600, outside the repo.
# Leave empty to keep the VPN and the tunnels off.
VPN_PROFILE=
# Fallback for a WireGuard profile only. An OpenVPN profile carries its own end date.
VPN_PROFILE_DAYS=90

# Airflow API users for the OpenCode agent. Created by hand in each cluster with the custom
# role PipelineStarter (it can start runs and cannot delete). See homelab/docs/runbook.md.
AIRFLOW_DEV_USERNAME=
AIRFLOW_DEV_PASSWORD=
AIRFLOW_PROD_USERNAME=
AIRFLOW_PROD_PASSWORD=
