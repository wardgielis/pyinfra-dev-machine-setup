{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "padding": { "top": 1, "left": 2 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "blue" }
  },
  "modules": [
    "title",
    "separator",
    { "type": "os", "key": "OS" },
    "host",
    "kernel",
    "uptime",
    "cpu",
    { "type": "memory", "key": "Memory" },
    { "type": "disk", "key": "Disk", "folders": "/" },
    { "type": "localip", "key": "IP" }
  ]
}
