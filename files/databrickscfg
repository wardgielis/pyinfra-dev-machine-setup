[DEFAULT]

[development]
host         = ${DATABRICKS_DEV_HOST}
account_id   = ${DATABRICKS_ACCOUNT_ID}
workspace_id = ${DATABRICKS_DEV_WORKSPACE_ID}
auth_type    = databricks-cli

[production]
host         = ${DATABRICKS_PROD_HOST}
account_id   = ${DATABRICKS_ACCOUNT_ID}
workspace_id = ${DATABRICKS_PROD_WORKSPACE_ID}
auth_type    = databricks-cli

[__settings__]
auth_storage = secure
