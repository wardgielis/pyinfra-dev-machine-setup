{
  "$$schema": "https://opencode.ai/config.json",
  "plugins": [
    "@khalilgharbaoui/opencode-claude-code-plugin"
  ],
  "policies": [
    { "action": "provider.use", "resource": "gitlab", "effect": "deny" }
  ],
  "providers": {
    "claude-code": {
      "settings": {
        "proxyTools": ["Bash", "Edit", "Write", "WebFetch"],
        "bridgeOpencodeMcp": true
      }
    }
  },
  "mcp": {
    "servers": {
      "pycharm": { "type": "remote", "url": "${PYCHARM_MCP_URL}" },
      "homebrew": { "type": "local", "command": ["brew", "mcp-server"] },
      "argocd": {
        "type": "local",
        "command": ["npx", "-y", "argocd-mcp", "stdio"],
        "environment": {
          "ARGOCD_BASE_URL": "${ARGOCD_BASE_URL}",
          "ARGOCD_API_TOKEN": "${ARGOCD_API_TOKEN}"
        }
      },
      "atlassian": { "type": "remote", "url": "https://mcp.atlassian.com/v2/mcp" },
      "gitlab": { "type": "remote", "url": "https://gitlab.com/api/v4/mcp" },
      "opentofu": { "type": "remote", "url": "https://mcp.opentofu.org/mcp" },
      "aws": {
        "type": "local",
        "command": ["uvx", "mcp-proxy-for-aws@latest", "https://aws-mcp.us-east-1.api.aws/mcp", "--region", "eu-west-1"]
      },
      "databricks": {
        "type": "local",
        "command": [
          "uvx", "uc-mcp-proxy",
          "--url", "https://dbc-03ed8bbb-c0ec.cloud.databricks.com/api/2.0/mcp/sql",
          "--auth-type", "databricks-cli",
          "--profile", "development"
        ]
      }
    }
  },
  "skills": ["${OPENCODE_SKILLS_PATH}"]
}
