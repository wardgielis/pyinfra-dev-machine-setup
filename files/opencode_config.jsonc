{
  "$$schema": "https://opencode.ai/config.json",
  "plugin": [
    "@khalilgharbaoui/opencode-claude-code-plugin"
  ],
  "disabled_providers": ["gitlab"],
  "provider": {
    "claude-code": {
      "options": {
        "proxyTools": ["Bash", "Edit", "Write", "WebFetch"],
        "bridgeOpencodeMcp": true
      }
    }
  },
  "skills": {
    "paths": ["${OPENCODE_SKILLS_PATH}"]
  }
}
